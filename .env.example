# Скопируйте в .env и задайте свои значения. Файл .env не коммитится.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://checkbalance:change-me-local-only@localhost:5432/checkbalance
SESSION_TTL_HOURS=12
# Пароль первого администратора: используется только командой bootstrap.
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
